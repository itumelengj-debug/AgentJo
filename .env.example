# Copy to .env (or set these in your shell / container) and fill in what you use.
# Only ANTHROPIC_API_KEY is needed for the default cloud setup.

ANTHROPIC_API_KEY=

# Engine backend:  anthropic (Claude only) | hybrid (Claude + local Ollama) | ollama
AGENT_BACKEND=anthropic
# AGENT_MODEL=claude-sonnet-4-6

# DeepSeek V4 / any OpenAI-compatible engine (optional)
# AGENT_DEEPSEEK_KEY=
# AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Where memory, engines.json and settings are stored (defaults to ~/.local_agent)
# AGENT_HOME=/data

# Other names this machine is reached by (a reverse proxy, a Tailscale name).
# Loopback, IP addresses and this computer's own name always work.
# AGENT_ALLOWED_HOSTS=agent.example.org,.tail1234.ts.net
# A separately hosted front end allowed to make changes (a dev server, say).
# AGENT_ALLOWED_ORIGINS=http://localhost:5173
